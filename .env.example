# AI Document Intelligence System - Root Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=15
ENABLE_DOCS=true
DATA_DIR=data

# Frontend Settings (Next.js public environment variables)
NEXT_PUBLIC_API_URL=http://localhost:8000
