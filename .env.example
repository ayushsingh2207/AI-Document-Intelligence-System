# AI Document Intelligence System - Root Environment Configuration Example

# Backend Settings
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
# In production, set ALLOWED_ORIGINS to trusted frontend domain(s) without localhost
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_UPLOAD_SIZE_MB=15
ENABLE_DOCS=true
DATA_DIR=data

# Public Demo Mode Settings
# Set DEMO_MODE=true in public portfolio demos to disable uploads/deletions and isolate demo corpus
DEMO_MODE=false
DEMO_DATA_DIR=data/demo

# Rate Limiting Settings
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_SEARCH=20/minute
RATE_LIMIT_QA=15/minute
RATE_LIMIT_CONTRACT=10/minute

# Frontend Settings (Next.js public environment variables baked at build time)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=false
